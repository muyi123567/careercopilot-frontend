{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careercopilot.cn/contracts/career-navigation/2.0.0",
  "title": "Career Navigation API response",
  "description": "Canonical V2 response contract. It reports evidence and uncertainty; it never represents a career path as a success probability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "request_id",
    "generated_at",
    "data",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "status": {
      "enum": [
        "ok",
        "data_insufficient",
        "service_failure"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/navigation_result"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/navigation_result"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "data_insufficient"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "allOf": [
              {
                "$ref": "#/$defs/navigation_result"
              },
              {
                "properties": {
                  "coverage_gaps": {
                    "minItems": 1
                  }
                }
              }
            ]
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "service_failure"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "data_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geographies",
        "industries",
        "experience_levels",
        "population",
        "time_window"
      ],
      "properties": {
        "geographies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "experience_levels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "time_window": {
          "$ref": "#/$defs/time_window"
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "name",
        "description",
        "version"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "level",
        "basis",
        "interpretation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sample_variability",
            "model_estimate",
            "data_coverage",
            "extraction_quality",
            "not_available"
          ]
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "lower",
            "upper",
            "coverage"
          ],
          "properties": {
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            },
            "coverage": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        "interpretation": {
          "type": "string",
          "minLength": 1,
          "description": "Must explain what is uncertain. It must not describe path success or personal suitability as a probability."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "title",
        "license",
        "version",
        "observed_at",
        "scope",
        "methodology"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "source_type": {
          "enum": [
            "user_confirmed",
            "job_posting",
            "official_taxonomy",
            "survey",
            "trajectory_dataset",
            "market_dataset",
            "model_output",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "sample_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "scope": {
          "$ref": "#/$defs/data_scope"
        },
        "methodology": {
          "$ref": "#/$defs/methodology"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "claim",
        "classification",
        "evidence_grade",
        "source_ids",
        "user_confirmation",
        "extraction_confidence",
        "uncertainty"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "fact",
            "inference",
            "recommendation"
          ]
        },
        "evidence_grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "U"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "user_confirmation": {
          "enum": [
            "not_required",
            "pending",
            "confirmed",
            "rejected"
          ]
        },
        "extraction_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Quality of information extraction only; never a career success or suitability probability."
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        }
      }
    },
    "occupation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occupation_id",
        "name"
      ],
      "properties": {
        "occupation_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "title",
        "expected_signal",
        "timebox_days"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "expected_signal": {
          "type": "string",
          "minLength": 1
        },
        "timebox_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "path_type",
        "target_occupation",
        "summary",
        "benefits",
        "costs",
        "key_gaps",
        "minimum_validation_actions",
        "counterevidence",
        "evidence_ids",
        "source_ids",
        "uncertainty"
      ],
      "properties": {
        "path_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "path_type": {
          "enum": [
            "deepen",
            "adjacent",
            "explore"
          ]
        },
        "target_occupation": {
          "$ref": "#/$defs/occupation"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "benefits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "costs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimum_validation_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation_action"
          }
        },
        "counterevidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        }
      }
    },
    "navigation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_occupation",
        "paths",
        "evidence",
        "sources",
        "coverage_gaps"
      ],
      "properties": {
        "current_occupation": {
          "anyOf": [
            {
              "$ref": "#/$defs/occupation"
            },
            {
              "type": "null"
            }
          ]
        },
        "paths": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "coverage_gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "trace_id"
      ],
      "properties": {
        "code": {
          "enum": [
            "UPSTREAM_UNAVAILABLE",
            "CONTRACT_VIOLATION",
            "RATE_LIMITED",
            "AUTH_REQUIRED",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
