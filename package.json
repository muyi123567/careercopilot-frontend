{
  "name": "careercopilot-frontend-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CareerCopilot V2 前端：响应式职业导航 Web/PWA（契约驱动、证据优先、无障碍）",
  "scripts": {
