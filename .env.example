# CareerCopilot 前端环境变量模板
# 复制此文件为 .env.local 并填入真实值
# cp .env.example .env.local

# ── API 基础地址 ──
# 开发环境: http://localhost:8000
# 生产环境: https://<fc-function-url>
# 注意: 这是后端 FC 函数的公网访问地址
VITE_API_BASE_URL=http://localhost:8000

# ── 运行时配置（可选）──
# 是否强制使用 Mock 数据（开发调试用）
# VITE_USE_MOCK=true

# Mock 场景: ok | data_insufficient | service_failure
# VITE_MOCK_SCENARIO=ok
